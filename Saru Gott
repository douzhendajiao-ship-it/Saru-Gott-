-- タッチ位置から狙う座標を計算
local function getTouchTarget(screenPos)
	local camera = workspace.CurrentCamera
	if not camera then return nil end

	local ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)

	-- 自分とミサイル本体をRaycastから除外
	local filter = {player.Character}
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj.Name == "物人ミサイル" then
			table.insert(filter, obj)
		end
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter

	local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	if result then
		return result.Position
	else
		return ray.Origin + ray.Direction * 1000
	end
end

-- 発射
fireBtn.MouseButton1Click:Connect(function()
	remote:FireServer("spawn")
	controlling = true
end)

-- 停止して爆発
stopBtn.MouseButton1Click:Connect(function()
	remote:FireServer("stop")
	controlling = false
end)

-- スマホ：タッチ開始で照準
UserInputService.TouchStarted:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not controlling then return end

	local target = getTouchTarget(input.Position)
	if target then
		remote:FireServer("target", target)
	end
end)

-- スマホ：指を動かして誘導
UserInputService.TouchMoved:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not controlling then return end

	local target = getTouchTarget(input.Position)
	if target then
		remote:FireServer("target", target)
	end
end)
